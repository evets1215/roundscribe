// Prisma schema for Roundscribe
// SQLite for local dev — zero-config, no Docker needed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Auth.js required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application models ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("physician")

  accounts     Account[]
  sessions     Session[]
  patients     Patient[]
  auditLogs    AuditLog[]
  handoffTasks HandoffTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id     String @id @default(cuid())
  name   String
  room   String
  mrn    String
  dob    String
  sex    String
  status String  @default("Pending")
  pinned Boolean @default(false)

  handoffNote String @default("")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes      Note[]
  recordings AudioRecording[]
  auditLogs  AuditLog[]
  tasks      HandoffTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Note {
  id        String @id @default(cuid())
  patientId String

  transcript    String
  noteJson      Json
  audioKey      String?
  type          String  @default("generated") // manual-paste | generated | accepted
  sourceTaskIds Json?   // JSON array of HandoffTask IDs that contributed to this note

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model AudioRecording {
  id        String @id @default(cuid())
  patientId String

  storageKey String
  mimeType   String
  sizeBytes  Int?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([patientId])
}

model HandoffTask {
  id         String    @id @default(cuid())
  patientId  String
  userId     String
  text       String
  status     String    @default("pending")
  source     String    @default("manual") // manual | parsed | paste
  dayNumber  Int       @default(1)
  sortOrder  Int       @default(0)
  resolvedAt DateTime?
  resolvedBy String?   // user | loop_closure
  resolvedNote String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@index([userId])
}

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  patientId String?
  action    String
  details   Json?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([patientId])
}
